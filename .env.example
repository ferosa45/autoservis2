# PostgreSQL connection string (Neon nebo Railway)
DATABASE_URL="postgresql://user:password@host:5432/autoservis?schema=public"

# Auth.js
AUTH_SECRET="vygeneruj pomoci: npx auth secret"
AUTH_URL="http://localhost:3000"

# Veřejná URL appky - používá se pro Stripe redirect URL a odkazy v emailech
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Interní Garazio Admin - email musí odpovídat existujícímu uživatelskému účtu
GARAZIO_ADMIN_EMAIL="admin@tvoje-domena.cz"

# Resend - API klíč pro odesílání emailů z garazio.cz
RESEND_API_KEY="re_..."
EMAIL_FROM="Garazio <noreply@garazio.cz>"

# Tajný token pro Vercel Cron endpoint /api/cron/trial-emails
CRON_SECRET="vygeneruj nahodny tajny retezec"

# Stripe - najdeš v Stripe Dashboard > Developers > API keys
STRIPE_SECRET_KEY="sk_test_..."
# Stripe Dashboard > Products > vytvoř produkt "Garazio předplatné"
# s cenou 299 Kč / měsíc opakovaně -> zkopíruj Price ID (začíná "price_")
STRIPE_PRICE_ID="price_..."
# Stripe Dashboard > Developers > Webhooks > přidej endpoint
# https://tvoje-domena.cz/api/stripe/webhook, events: checkout.session.completed,
# customer.subscription.updated, customer.subscription.deleted, invoice.payment_failed
# -> zkopíruj Signing secret
STRIPE_WEBHOOK_SECRET="whsec_..."
