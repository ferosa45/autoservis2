generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role { OWNER MECHANIC }
enum JobStatus { WAITING IN_PROGRESS BLOCKED DONE }
enum InvoiceStatus { DRAFT ISSUED PAID CANCELLED }
enum SubscriptionStatus { TRIALING ACTIVE PAST_DUE CANCELED }

model Garage {
  id String @id @default(cuid())
  name String
  companyName String?
  ico String?
  dic String?
  street String?
  city String?
  zip String?
  country String @default("CZ")
  email String?
  phone String?
  bankAccount String?
  iban String?
  isVatPayer Boolean @default(false)
  defaultVatRate Decimal? @db.Decimal(5, 2)
  invoicePrefix String?
  nextInvoiceNumber Int @default(1)
  invoiceDueDays Int @default(14)
  subscriptionStatus SubscriptionStatus @default(TRIALING)
  trialEndsAt DateTime
  stripeCustomerId String? @unique
  stripeSubscriptionId String? @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users User[]
  customers Customer[]
  vehicles Vehicle[]
  jobs Job[]
  jobTasks JobTask[]
  jobItems JobItem[]
  invoices Invoice[]
  invoiceItems InvoiceItem[]
  tasks Task[]
  workSessions WorkSession[]
}

model User {
  id String @id @default(cuid())
  name String
  email String @unique
  password String
  role Role
  garageId String
  garage Garage @relation(fields: [garageId], references: [id])
  active Boolean @default(true)
  canInvoice Boolean @default(false)
  canViewInvoices Boolean @default(false)
  canViewFinancials Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  assignedJobs Job[] @relation("AssignedUser")
  workSessions WorkSession[]
  @@index([garageId])
}

model Customer {
  id String @id @default(cuid())
  name String
  phone String
  email String?
  note String?
  companyName String?
  ico String?
  dic String?
  street String?
  city String?
  zip String?
  garageId String
  garage Garage @relation(fields: [garageId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  vehicles Vehicle[]
  jobs Job[]
  invoices Invoice[]
  @@index([garageId])
  @@index([garageId, phone])
}

model Vehicle {
  id String @id @default(cuid())
  brand String
  model String
  licensePlate String?
  year Int?
  mileage Int?
  note String?
  customerId String
  customer Customer @relation(fields: [customerId], references: [id])
  garageId String
  garage Garage @relation(fields: [garageId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  jobs Job[]
  @@index([garageId])
  @@index([garageId, licensePlate])
}

model Job {
  id String @id @default(cuid())
  number String
  customerId String
  customer Customer @relation(fields: [customerId], references: [id])
  vehicleId String
  vehicle Vehicle @relation(fields: [vehicleId], references: [id])
  scheduledStart DateTime
  scheduledEnd DateTime?
  status JobStatus @default(WAITING)
  customerRequest String
  note String?
  assignedUserId String?
  assignedUser User? @relation("AssignedUser", fields: [assignedUserId], references: [id])
  garageId String
  garage Garage @relation(fields: [garageId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tasks JobTask[]
  items JobItem[]
  invoices Invoice[]
  todos Task[]
  workSessions WorkSession[]
  @@unique([garageId, number])
  @@index([garageId])
  @@index([garageId, scheduledStart])
}

model WorkSession {
  id String @id @default(cuid())
  startedAt DateTime @default(now())
  endedAt DateTime?
  jobId String
  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)
  userId String
  user User @relation(fields: [userId], references: [id])
  garageId String
  garage Garage @relation(fields: [garageId], references: [id])
  createdAt DateTime @default(now())
  @@index([jobId])
  @@index([userId])
  @@index([garageId])
  @@index([jobId, endedAt])
}

model JobTask {
  id String @id @default(cuid())
  title String
  completed Boolean @default(false)
  jobId String
  job Job @relation(fields: [jobId], references: [id])
  garageId String
  garage Garage @relation(fields: [garageId], references: [id])
  createdAt DateTime @default(now())
  @@index([garageId])
  @@index([jobId])
}

model JobItem {
  id String @id @default(cuid())
  title String
  quantity Decimal @db.Decimal(10, 2)
  unit String
  unitPrice Decimal @db.Decimal(10, 2)
  jobId String
  job Job @relation(fields: [jobId], references: [id])
  garageId String
  garage Garage @relation(fields: [garageId], references: [id])
  createdAt DateTime @default(now())
  @@index([garageId])
  @@index([jobId])
}

model Invoice {
  id String @id @default(cuid())
  number String?
  jobId String?
  job Job? @relation(fields: [jobId], references: [id])
  customerId String
  customer Customer @relation(fields: [customerId], references: [id])
  garageId String
  garage Garage @relation(fields: [garageId], references: [id])
  status InvoiceStatus @default(DRAFT)
  supplierName String
  supplierIco String?
  supplierDic String?
  supplierStreet String?
  supplierCity String?
  supplierZip String?
  customerName String
  customerIco String?
  customerDic String?
  customerStreet String?
  customerCity String?
  customerZip String?
  issueDate DateTime
  dueDate DateTime
  subtotal Decimal @db.Decimal(10, 2)
  vatTotal Decimal @db.Decimal(10, 2)
  total Decimal @db.Decimal(10, 2)
  note String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items InvoiceItem[]
  @@unique([garageId, number])
  @@index([garageId])
  @@index([jobId])
}

model InvoiceItem {
  id String @id @default(cuid())
  invoiceId String
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  garageId String
  garage Garage @relation(fields: [garageId], references: [id])
  title String
  quantity Decimal @db.Decimal(10, 2)
  unit String
  unitPrice Decimal @db.Decimal(10, 2)
  vatRate Decimal @db.Decimal(5, 2)
  subtotal Decimal @db.Decimal(10, 2)
  vatAmount Decimal @db.Decimal(10, 2)
  total Decimal @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  @@index([garageId])
  @@index([invoiceId])
}

model Task {
  id String @id @default(cuid())
  title String
  completed Boolean @default(false)
  dueDate DateTime?
  jobId String?
  job Job? @relation(fields: [jobId], references: [id])
  garageId String
  garage Garage @relation(fields: [garageId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([garageId])
  @@index([garageId, dueDate])
}
